{
    "config": {
        "experiment_name": "tiny_tversky_vae",
        "seeds": [
            0
        ],
        "data": {
            "dataset_name": "gridrobot_1960",
            "path": "simulated_data/001-gridrobot/data/gridrobot_1960.npz"
        },
        "model": {
            "load_ckpt": false,
            "name": "tversky_vae",
            "latent_dim": [
                6
            ],
            "num_epochs": 3000,
            "lr": 0.004,
            "lr_decay": 0.99999,
            "margin": 0.1,
            "log_interval": 100,
            "use_symmetric_loss": true,
            "l2_weight": 0.0,
            "fbank_size": [
                16
            ],
            "similarity_model": "contrast",
            "intersection_reduction": "product",
            "difference_reduction": "substractmatch"
        },
        "eval": [
            {
                "method": "query",
                "max_pairs": 1000
            }
        ]
    }
}